# Copy to server/.env and fill in your keys:  cp server/.env.example server/.env

# Required — Google Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Required — Tavily web search API key: https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# Optional — Gemini model name (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional — backend port (default: 3001; the Vite proxy expects 3001)
# PORT=3001

# Optional — LangSmith tracing (https://smith.langchain.com → Settings → API Keys)
# Every agent run (model calls, tool calls, inputs/outputs) is traced automatically when enabled.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=wanderly
# Non-US accounts: set your region's endpoint, e.g. https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
