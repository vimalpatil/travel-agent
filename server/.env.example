# Copy to server/.env and fill in your keys:  cp server/.env.example server/.env

# Required — Google Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Required — Tavily web search API key: https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# Optional — Gemini model name (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional — backend port (default: 3001; the Vite proxy expects 3001)
# PORT=3001
